<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
 <!-- Starts in light mode; JS will check localStorage -->
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - InkNest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"> <!-- For sun/moon icons -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyBlogSite.styles.css" asp-append-version="true" />
</head>
<body class="inknest-theme">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm box-shadow mb-3 newsroom-nav">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Blog" asp-action="Index">InkNest</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav me-auto newsroom-nav-links">
                        <li class="nav-item"><a class="nav-link" asp-controller="Blog" asp-action="Index">Newsroom</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Blog" asp-action="Index" asp-route-searchString="">Topics</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Blog" asp-action="Index" asp-route-page="1">Stories</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">About</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <partial name="_LoginPartial" /> <!-- Auth links on right -->
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="newsroom-footer">
        <div class="container footer-grid">
            <div>
                <h4>InkNest</h4>
                <p>Curated stories, product insights, and interviews tailored for curious minds.</p>
                <div class="footer-social">
                    <a href="#"><i class="bi bi-twitter"></i></a>
                    <a href="#"><i class="bi bi-instagram"></i></a>
                    <a href="#"><i class="bi bi-linkedin"></i></a>
                    <a href="#"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
            <div>
                <h5>Company</h5>
                <ul>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Terms</a></li>
                    <li><a asp-controller="Blog" asp-action="Index">Press</a></li>
                    <li><a asp-controller="Blog" asp-action="Index">Careers</a></li>
                </ul>
            </div>
            <div>
                <h5>Product</h5>
                <ul>
                    <li><a asp-controller="Blog" asp-action="Index">Features</a></li>
                    <li><a asp-controller="Blog" asp-action="Index">Guides</a></li>
                    <li><a asp-controller="Blog" asp-action="Index">Roadmap</a></li>
                </ul>
            </div>
            <div>
                <h5>Newsletter</h5>
                <p>Subscribe for weekly insights.</p>
                <form class="footer-subscribe">
                    <input type="email" placeholder="Your email" />
                    <button type="submit" class="btn btn-gradient">Subscribe</button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; 2025 InkNest. All rights reserved.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
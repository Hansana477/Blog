@model IEnumerable<blog.Models.BlogPost>

@{
    ViewData["Title"] = "Blog Posts";
    var searchString = ViewBag.SearchString as string ?? "";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

<section class="news-hero">
    <div class="hero-top">
        <div class="pill">Stories</div>
        <div class="pill">Product</div>
        <div class="pill">Impact</div>
        <div class="pill">Behind the scenes</div>
    </div>
    <h1>Newsroom</h1>
    <p class="hero-subtitle">Insights and stories about our products, our team, and the community we serve.</p>
    <div class="hero-actions">
        <a class="btn btn-gradient" asp-area="Identity" asp-page="/Account/Register">Start Free Trial</a>
        <form asp-action="Index" method="get" class="search-compact">
            <input type="text" name="searchString" placeholder="Search posts..." value="@searchString" />
            <button type="submit"><i class="bi bi-search"></i></button>
        </form>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="admin-actions">
            <a asp-action="Create" class="btn btn-secondary">New Post</a>
        </div>
    }
</section>

@if (!Model.Any())
{
    <div class="empty-state">No posts found. @if (User.IsInRole("Admin")) { <a asp-action="Create">Create one?</a>}</div>
}
else
{
    var featured = Model.FirstOrDefault();
    var rest = Model.Skip(1).ToList();

    <section class="featured-grid">
        @if (featured != null)
        {
            <div class="featured-card">
                @if (!string.IsNullOrEmpty(featured.ImagePath))
                {
                    <div class="featured-media" style="background-image:url('@Url.Content($"~/{featured.ImagePath}")');"></div>
                }
                <div class="featured-body">
                    <div class="eyebrow">Highlight · @featured.PostedDate.ToString("MMMM d, yyyy")</div>
                    <h2>@featured.Title</h2>
                    <p>@(featured.Content.Length > 140 ? featured.Content.Substring(0, 140) + "..." : featured.Content)</p>
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@featured.Id">Read Story</a>
                </div>
            </div>
        }
        <div class="newsletter-card">
            <h4>Subscribe</h4>
            <p>Get weekly updates on new stories and product drops.</p>
            <form class="newsletter-form">
                <input type="email" placeholder="Your email" />
                <button type="submit" class="btn btn-gradient">Start Free Trial</button>
            </form>
            <div class="social-row">
                <span>Follow us</span>
                <div class="social-icons">
                    <a href="#"><i class="bi bi-twitter"></i></a>
                    <a href="#"><i class="bi bi-instagram"></i></a>
                    <a href="#"><i class="bi bi-facebook"></i></a>
                    <a href="#"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
        </div>
    </section>

    <section class="news-grid">
        @foreach (var post in rest)
        {
            <article class="news-card">
                @if (!string.IsNullOrEmpty(post.ImagePath))
                {
                    <div class="news-thumb" style="background-image:url('@Url.Content($"~/{post.ImagePath}")');"></div>
                }
                <div class="news-meta">
                    <span>@post.PostedDate.ToString("MMMM d, yyyy")</span>
                    @if (!string.IsNullOrEmpty(post.Author))
                    {
                        <span>· @post.Author</span>
                    }
                </div>
                <h5>@post.Title</h5>
                <p>@(post.Content.Length > 120 ? post.Content.Substring(0,120) + "..." : post.Content)</p>
                <div class="news-actions">
                    <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-secondary btn-sm">Read more</a>
                    <div class="news-stats">
                        <span><i class="bi bi-heart-fill"></i> @post.Likes.Count</span>
                        <span><i class="bi bi-chat"></i> @post.Comments.Count</span>
                    </div>
                </div>
            </article>
        }
    </section>

    @if (totalPages > 1)
    {
        <nav aria-label="Blog pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@searchString">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@searchString">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@searchString">Next</a>
                </li>
            </ul>
        </nav>
    }
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
    var hasExternal = (Model.ExternalLogins?.Count ?? 0) > 0;
}

<section class="auth-shell gradient-ink">
    <div class="auth-card">
        <div class="auth-pane auth-pane--form">
            <div class="auth-brand">
                <span class="brand-dot"></span>
                <span class="brand-bar"></span>
                <span class="brand-dot"></span>
            </div>
            <div class="auth-heading">
                <p class="eyebrow">Join the community</p>
                <h1>Create your InkNest account</h1>
                <p class="subhead">Save favorites, comment, and stay in the loop.</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <label class="auth-label">Email</label>
                <div class="auth-input">
                    <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>

                <label class="auth-label mt-3">Password</label>
                <div class="auth-input">
                    <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="Create a password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>

                <label class="auth-label mt-3">Confirm password</label>
                <div class="auth-input">
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Repeat password" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>

                <button id="registerSubmit" type="submit" class="auth-btn primary mt-4">Create account</button>

                <p class="auth-meta">Already have an account?
                    <a class="auth-link" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
                </p>

                @if (hasExternal)
                {
                    <div class="auth-external">
                        <p>Or continue with</p>
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="auth-external-buttons">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="auth-btn ghost" name="provider" value="@provider.Name">@provider.DisplayName</button>
                                }
                            </div>
                        </form>
                    </div>
                }
            </form>
        </div>

        <div class="auth-pane auth-pane--spotlight">
            <div class="quote-card">
                <p class="quote-eyebrow">InkNest highlights</p>
                <h2>“Inspiration, expertise, and community—right where you read.”</h2>
                <p class="quote-body">Follow your favorite authors, discover new topics, and keep your reading list synced everywhere.</p>
                <div class="quote-author">
                    <strong>Alex Morgan</strong>
                    <span>Product Lead at Notion</span>
                </div>
                <div class="quote-actions">
                    <button type="button" class="auth-btn pill">←</button>
                    <button type="button" class="auth-btn pill ghost">→</button>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

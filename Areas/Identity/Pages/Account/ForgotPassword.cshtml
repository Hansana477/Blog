@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<section class="auth-shell gradient-ink">
    <div class="auth-card">
        <div class="auth-pane auth-pane--form">
            <div class="auth-brand">
                <span class="brand-dot"></span>
                <span class="brand-bar"></span>
                <span class="brand-dot"></span>
            </div>
            <div class="auth-heading">
                <p class="eyebrow">Password help</p>
                <h1>Forgot your password?</h1>
                <p class="subhead">Enter the email you used to create your InkNest account and we’ll send a reset link.</p>
            </div>

            <form method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <label class="auth-label">Email</label>
                <div class="auth-input">
                    <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>

                <button type="submit" class="auth-btn primary mt-3">Send reset link</button>

                <p class="auth-meta mt-2">
                    Remembered it? <a class="auth-link" asp-page="./Login">Back to sign in</a>
                </p>
            </form>
        </div>

        <div class="auth-pane auth-pane--spotlight">
            <div class="quote-card">
                <p class="quote-eyebrow">Security tip</p>
                <h2>Use a unique password you don’t reuse on other sites.</h2>
                <p class="quote-body">Turn on multi-factor authentication in your account settings for an extra layer of protection.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

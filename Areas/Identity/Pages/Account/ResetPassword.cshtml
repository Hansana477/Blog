@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="auth-shell gradient-ink">
    <div class="auth-card">
        <div class="auth-pane auth-pane--form">
            <div class="auth-brand">
                <span class="brand-dot"></span>
                <span class="brand-bar"></span>
                <span class="brand-dot"></span>
            </div>
            <div class="auth-heading">
                <p class="eyebrow">Create a new password</p>
                <h1>Reset your password</h1>
                <p class="subhead">Choose a strong password that you haven’t used on InkNest before.</p>
            </div>

            <form method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />

                <label class="auth-label">Email</label>
                <div class="auth-input">
                    <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>

                <label class="auth-label mt-3">New password</label>
                <div class="auth-input">
                    <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>

                <label class="auth-label mt-3">Confirm password</label>
                <div class="auth-input">
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>

                <button type="submit" class="auth-btn primary mt-3">Update password</button>
            </form>
        </div>

        <div class="auth-pane auth-pane--spotlight">
            <div class="quote-card">
                <p class="quote-eyebrow">Next steps</p>
                <p class="quote-body">After updating your password, you’ll be able to sign back into InkNest with your new credentials.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

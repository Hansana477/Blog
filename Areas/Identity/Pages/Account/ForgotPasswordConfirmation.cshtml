@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your inbox";
}

<section class="auth-shell gradient-ink">
    <div class="auth-card">
        <div class="auth-pane auth-pane--form">
            <div class="auth-brand">
                <span class="brand-dot"></span>
                <span class="brand-bar"></span>
                <span class="brand-dot"></span>
            </div>
            <div class="auth-heading">
                <p class="eyebrow">Password reset sent</p>
                <h1>Check your email</h1>
                <p class="subhead">
                    If an account exists for the address you entered, we’ve sent a link to reset your password.
                </p>
            </div>

            <p class="auth-meta">
                Didn’t see the email? Check your spam folder or try again.
            </p>

            <a class="auth-btn ghost mt-3" asp-page="./Login">Back to sign in</a>
        </div>

        <div class="auth-pane auth-pane--spotlight">
            <div class="quote-card">
                <p class="quote-eyebrow">Heads up</p>
                <p class="quote-body">
                    For development, reset links are written to the application’s debug output using the built‑in EmailSender service.
                </p>
            </div>
        </div>
    </div>
</section>
